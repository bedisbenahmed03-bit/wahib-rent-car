---
<section id="services" class="py-20 bg-black">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-4xl font-bold text-center text-white mb-2" data-i18n="services_title">Our Services</h2>
    <p class="text-center text-gray-400 mb-12" data-i18n="services_subtitle">Transport solutions designed for your needs</p>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-zinc-900 border border-yellow-700/20 rounded-2xl p-6 text-center hover:border-yellow-500 transition">
        <div class="text-4xl mb-4">🚗</div>
        <h3 class="text-white font-bold text-lg mb-2" data-i18n="service1_title">Short & Long Term</h3>
        <p class="text-gray-400 text-sm" data-i18n="service1_desc">Daily, weekly and monthly flexible plans</p>
      </div>
      <div class="bg-zinc-900 border border-yellow-700/20 rounded-2xl p-6 text-center hover:border-yellow-500 transition">
        <div class="text-4xl mb-4">✈️</div>
        <h3 class="text-white font-bold text-lg mb-2" data-i18n="service2_title">Airport Transfers</h3>
        <p class="text-gray-400 text-sm" data-i18n="service2_desc">Pickup & dropoff at Enfidha & Monastir airports</p>
      </div>
      <div class="bg-zinc-900 border border-yellow-700/20 rounded-2xl p-6 text-center hover:border-yellow-500 transition">
        <div class="text-4xl mb-4">🗺️</div>
        <h3 class="text-white font-bold text-lg mb-2" data-i18n="service3_title">Excursions</h3>
        <p class="text-gray-400 text-sm" data-i18n="service3_desc">Explore Tunisia with a reliable vehicle</p>
      </div>
      <div class="bg-zinc-900 border border-yellow-700/20 rounded-2xl p-6 text-center hover:border-yellow-500 transition">
        <div class="text-4xl mb-4">🏢</div>
        <h3 class="text-white font-bold text-lg mb-2" data-i18n="service4_title">Corporate Rentals</h3>
        <p class="text-gray-400 text-sm" data-i18n="service4_desc">Dedicated fleet solutions for businesses</p>
      </div>
    </div>
  </div>
</section>