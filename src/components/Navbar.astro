---
---
<nav class="fixed top-0 left-0 w-full z-50 bg-black border-b border-yellow-700/30">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/">
      <img src="/logo.png" alt="Wahib Rent Car" class="h-32 w-auto object-left" />
    </a>
    <div class="hidden md:flex items-center gap-8 text-white text-sm font-medium">
      <a href="#fleet" class="hover:text-yellow-500 transition" data-i18n="nav_fleet">Fleet</a>
      <a href="#services" class="hover:text-yellow-500 transition" data-i18n="nav_services">Services</a>
      <a href="#why-us" class="hover:text-yellow-500 transition" data-i18n="nav_whyus">Why Us</a>
      <a href="#faq" class="hover:text-yellow-500 transition" data-i18n="nav_faq">FAQ</a>
      <a href="#contact" class="hover:text-yellow-500 transition" data-i18n="nav_contact">Contact</a>
    </div>
    <div class="flex items-center gap-3">
      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-xs font-bold">
        <button onclick="setLang('en')" id="lang-en" class="lang-btn px-2 py-1 rounded text-yellow-500 border border-yellow-500">EN</button>
        <button onclick="setLang('fr')" id="lang-fr" class="lang-btn px-2 py-1 rounded text-gray-400 border border-gray-600 hover:border-yellow-500 hover:text-yellow-500 transition">FR</button>
        <button onclick="setLang('ar')" id="lang-ar" class="lang-btn px-2 py-1 rounded text-gray-400 border border-gray-600 hover:border-yellow-500 hover:text-yellow-500 transition">AR</button>
      </div>
      <a href="#contact" class="bg-yellow-600 hover:bg-yellow-500 text-black font-bold px-5 py-2 rounded transition" data-i18n="nav_book">
        Book Now
      </a>
    </div>
  </div>
</nav>